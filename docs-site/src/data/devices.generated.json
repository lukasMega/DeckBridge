          "key": "crop",
          "label": "Crop",
          "numeric": true,
          "description": "Pixels trimmed off every side of the source before rotate/flip/resize — the K1 Pro drops a 6 px dead border out of its 80x80 input.",
          "defaultVisible": false
        },
        {
          "key": "resizeMode",
          "label": "Resize mode",
          "description": "How the source is fitted to width x height: resize interpolates to the panel size, pad keeps source pixels 1:1 and centres them in the canvas.",
          "defaultVisible": false
        },
        {
          "key": "padFill",
          "label": "Pad fill",
          "description": "Border fill used by resize mode pad: edge replicates the outer pixels, black, or average source colour. Ignored for resize.",
          "defaultVisible": false
        },
        {
          "key": "resizeFilter",
          "label": "Filter",
          "description": "Interpolation filter for the resize: triangle (default), nearest (K1 Pro, matches the known-good reference encoder), lanczos3 (best on upscale).",
          "defaultVisible": false
        },
        {
          "key": "sharpen",
          "label": "Sharpen",
          "numeric": true,
          "description": "Unsharp-mask sigma applied after the resize to recover crispness lost to upscaling. Adds detail, so it grows the JPEG; 0 = off.",
          "defaultVisible": false
        },
        {
          "key": "blur",
          "label": "Blur",
          "numeric": true,
          "description": "Gaussian blur sigma applied before the JPEG encode; 0 = off.",
          "defaultVisible": false
        },
        {
          "key": "maxBytes",
          "label": "Max bytes",
          "numeric": true,
          "description": "JPEG size cap — the encoder retries at lower quality until the payload fits. 0 = no cap (BMP is fixed-size anyway).",
          "defaultVisible": true
        },
        {
          "key": "quality",
          "label": "Quality",
          "numeric": true,
          "description": "JPEG encode quality, 0 to 1. Unused for BMP panels.",
          "defaultVisible": true
        },
        {
          "key": "bmpPpm",
          "label": "BMP ppm",
          "numeric": true,
          "description": "Pixels-per-metre written into the BMP header; only the Elgato Mini insists on a value (2835).",
          "defaultVisible": false
        },
        {
          "key": "transform",
          "label": "Transform",
          "description": "How image-pipeline routes a CORA JPEG: passthrough sends it unchanged (CORA-native size, no rotate/flip/cap), sidecar resizes and rotates through the Rust transform.",
          "defaultVisible": true
        }
      ],
      "legend": "— = field omitted; the effective default applies — resizeFilter triangle · resizeMode resize · padFill edge · crop 0 · sharpen 0 · blur 0 · bmpPpm none (JPEG)."
