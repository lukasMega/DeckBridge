{
  "name": "docs-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "test:build": "node --test scripts/test-build.mts",
    "test:links": "node --test scripts/test-links.mts",
    "test:content": "node --test scripts/test-content.mts",
    "test:output": "node --test scripts/test-output.mts",
    "test:feeds": "node --test scripts/test-feeds.mts",
    "test": "npm run test:build && npm run test:links && npm run test:content && npm run test:output && npm run test:feeds",
    "test:cold": "npm run clear && npm run test",
    "beforeCommit": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@mermaid-js/mermaid-cli": "11.17.0",
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "// node": "22.18+ required by the test scripts, which are TypeScript run directly via native type stripping; floor raised to 24.13 to match every other project in the tree",
    "node": ">=24.13"
  }
}
