{
  "name": "deckbridge",
  "version": "0.11.1",
  "description": "DeckBridge: an alternative to a \"Network Dock\" device (>70 USD). Bridges a USB stream deck to Elgato Stream Deck software over TCP/CORA.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "lint": "oxlint src test && eslint src test",
    "format": "oxfmt src test",
    "typecheck": "/usr/bin/time tsgo --noEmit",
    "typecheck:tsc": "/usr/bin/time tsc --noEmit",
    "test": "mise run test",
    "test:client": "node scripts/test-client.mjs",
    "beforeCommit": "bun run format && bun run lint && bun run typecheck && bun run build && bun run test && bun run test:client",
    "outdated": "npm outdated --long --depth=0 ; bun outdated",
    "audit": "bun audit",
    "knip": "knip",
    "knip:fix": "knip --fix"
  },
  "devDependencies": {
    "@babel/parser": "8.0.5",
    "@eslint-react/eslint-plugin": "5.19.0",
    "@napi-rs/canvas": "1.0.9",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-regexp": "3.3.0",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "eventemitter3": "5.0.4",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-instrument": "6.0.3",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "knip": "6.35.1",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "preact": "10.29.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
