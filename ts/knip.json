{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main/app.ts",
    "src/worker/hid-worker.ts",
    "src/worker/hid-scan-worker.ts",
    "src/plugin/plugin-worker.ts",
    "src/web/client/ui-entry.ts",
    "src/web/client/deck/deck-entry.ts",
    "src/dev/mirabox-smoke.ts",
    "src/dev/k1pro-probe.ts",
    "src/dev/d6-capture.ts",
    "src/dev/akp05-capture.ts",
    "src/dev/akp05-strip-probe.ts",
    "src/dev/akp05-strip-guided-probe.ts",
    "test/**/*.test.ts",
    "scripts/*.mjs"
  ],
  "project": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "scripts/*.mjs"],
  "ignoreBinaries": ["mise"],
  "ignoreDependencies": ["tjs"],
  "ignoreExportsUsedInFile": true
}
